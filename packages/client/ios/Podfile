# Resolve react_native_pods.rb with node so hoisting is handled for us — this
# repo is a Yarn workspace and node_modules lives at the repo root, not here.
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'micdrp' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  target 'micdrpTests' do
    inherit! :complete
  end

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false
    )

    # react-native-config writes the generated env into tmp.xcconfig, which
    # env.xcconfig includes. Both have to reach every build configuration.
    %w[
      Pods/Target\ Support\ Files/Pods-micdrp/Pods-micdrp.debug.xcconfig
      Pods/Target\ Support\ Files/Pods-micdrp/Pods-micdrp.release.xcconfig
      Pods/Target\ Support\ Files/Pods-micdrp-micdrpTests/Pods-micdrp-micdrpTests.debug.xcconfig
      Pods/Target\ Support\ Files/Pods-micdrp-micdrpTests/Pods-micdrp-micdrpTests.release.xcconfig
    ].each do |path|
      next unless File.exist?(path)
      File.open(path, 'a') do |file|
        file.puts "\n#include? \"../../../env.xcconfig\""
        # The C++ DSP core is shared with Android and lives outside ios/, so the
        # AudioEngineModule bridge needs it on the header path. This belongs in
        # the pod xcconfig rather than the target's build settings: a
        # target-level HEADER_SEARCH_PATHS shadows the xcconfig entirely,
        # because $(inherited) there resolves to the project level.
        file.puts "HEADER_SEARCH_PATHS = $(inherited) \"$(PODS_ROOT)/../../cpp/dsp\""

        # React Native applies folly's configuration flags to its own pod
        # targets only. The stock template sidesteps that by making AppDelegate
        # Swift, so nothing in the app target ever parses a folly header. This
        # app's AppDelegate is Objective-C++ and does, and without
        # FOLLY_CFG_NO_COROUTINES folly reaches for <folly/coro/Coroutine.h>,
        # which the prebuilt dependencies do not ship. Mirror RN's own flags.
        file.puts "OTHER_CPLUSPLUSFLAGS = $(inherited) -DFOLLY_MOBILE=1 " \
                  "-DFOLLY_USE_LIBCPP=1 -DFOLLY_CFG_NO_COROUTINES=1 " \
                  "-DFOLLY_HAVE_CLOCK_GETTIME=1"
      end
    end
  end
end
