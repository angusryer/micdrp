# Template for the env files git-secret encrypts. Copy to .env, .env.staging
# and .env.production, fill in real values, then run `git secret hide` from the
# repo root. This file is committed; the filled copies never are.
#
# Consumed by react-native-config (bundled into the app at build time) and by
# fastlane's read_env_version.

# Supabase project — Project Settings > API. The anon key is a publishable
# client key; row-level security is what protects the data, not this value.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Marketing version (CFBundleShortVersionString) and build number
# (CFBundleVersion). BUILD_NUMBER must increase on every TestFlight upload.
VERSION_NUMBER=1.0.0
BUILD_NUMBER=1
