# Template for the env files git-secret encrypts. Copy to .env, .env.staging
# and .env.production, fill in real values, then run `git secret hide` from the
# repo root. This file is committed; the filled copies never are.
#
# Consumed by react-native-config (bundled into the app at build time) and by
# fastlane's read_env_version.

# The PocketBase instance.
#
#   deployed  https://micdrp-backend.fly.dev   reachable from any device
#   local     http://127.0.0.1:8090            backend/dev.sh, simulator only
#
# A TestFlight build must use the deployed URL: a tester's phone cannot reach
# your machine. The simulator can use either.
BACKEND_URL=https://micdrp-backend.fly.dev

# The iOS bundle identifier. Single source: Appfile, Fastfile and the Xcode
# project all derive from this value, so it is never written down twice.
IOS_BUNDLE_ID=io.greenlyre.micdrp

# Marketing version (CFBundleShortVersionString) and build number
# (CFBundleVersion). BUILD_NUMBER must increase on every TestFlight upload.
VERSION_NUMBER=1.0.0
BUILD_NUMBER=1

# Where the app asks whether a newer JavaScript bundle exists. Leaving this
# empty disables over-the-air updates entirely, which is the right setting for
# any build that is not going to TestFlight.
#
# Only a TestFlight install ever contacts it — an App Store install decides it
# is ineligible from its own receipt and makes no request (INV-UPD-001), so
# this value shipping inside a released binary is harmless.
OTA_UPDATE_URL=

# The release track this binary takes bundles from. `beta` is the only track
# that exists; a bundle is never served across tracks.
OTA_CHANNEL=beta
