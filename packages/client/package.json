{
  "name": "client",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "react-native start --reset-cache",
    "android:production": "react-native run-android --mode release",
    "android:staging": "react-native run-android --mode staging",
    "android:development": "react-native run-android --mode debug",
    "ios:production": "react-native run-ios --scheme micdrp",
    "ios:staging": "react-native run-ios --scheme micdrp-staging",
    "ios:development": "react-native run-ios --scheme micdrp-development",
    "pod": "cd ios && bundle exec pod install",
    "test": "jest",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dr.pogodin/react-native-fs": "^2.40.0",
    "@hot-updater/react-native": "0.36.1",
    "@react-navigation/bottom-tabs": "^7.18.17",
    "@react-navigation/native": "^7.3.17",
    "@react-navigation/native-stack": "^7.18.9",
    "@shopify/react-native-skia": "^2.11.0",
    "@xstate/react": "^6.1.0",
    "cross-env": "^10.1.0",
    "i18next": "^26.3.6",
    "lodash": "^4.18.1",
    "logic": "workspace:*",
    "pocketbase": "^0.28.0",
    "react": "^19.2.8",
    "react-i18next": "^17.0.11",
    "react-native": "^0.86.2",
    "react-native-audio-api": "^0.13.3",
    "react-native-config": "^1.6.1",
    "react-native-gesture-handler": "^3.2.1",
    "react-native-keychain": "^10.0.0",
    "react-native-localize": "^3.7.0",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.36.5",
    "react-native-reanimated": "^4.5.3",
    "react-native-safe-area-context": "^5.9.1",
    "react-native-screens": "^4.27.0",
    "react-native-share": "^12.3.1",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-worklets": "^0.11.4",
    "shared": "workspace:*",
    "xstate": "^5.32.5"
  },
  "codegenConfig": {
    "name": "AppSpecs",
    "type": "modules",
    "jsSrcsDir": "src/specs",
    "android": {
      "javaPackageName": "com.micdrp.specs"
    }
  },
  "devDependencies": {
    "@hot-updater/cloudflare": "0.36.1",
    "hot-updater": "0.36.1"
  }
}
