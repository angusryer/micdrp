{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "types": [
      "node",
      "jest"
    ],
    "isolatedModules": true,
    "allowJs": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "jsx": "react-native",
    "noEmit": true,
    "paths": {
      "logic": [
        "../logic/src/index.ts"
      ],
      "logic/*": [
        "../logic/src/*"
      ],
      "shared": [
        "../shared/src/index.ts"
      ],
      "shared/*": [
        "../shared/src/*"
      ]
    }
  },
  "exclude": [
    ".bundle",
    "android",
    "ios",
    "node_modules",
    "vendor"
  ]
}
