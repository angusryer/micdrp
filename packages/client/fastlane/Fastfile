# Fastfile — micdrp iOS and Android release lanes.
#
# ALL signing material, API keys, and credentials are read exclusively from
# environment variables injected by the CI system (GitHub Actions secrets).
# No secrets, keystore passwords, API keys, or hostnames are ever written here.
#
# iOS authenticates with ONE credential: an App Store Connect API key. That key
# both signs (sigh/cert create and fetch the certificate and profile on demand)
# and uploads (pilot/deliver). The previous setup used match, which additionally
# needed an Apple ID, a team id, a private git repo to hold the certificates,
# the passphrase encrypting them, and a keychain password — five secrets to
# provision and rotate, and a 2FA prompt whenever the Apple ID was challenged.
# An API key has none of those properties: it is non-interactive by design.
#
# Required environment variables are documented in fastlane/README.md.

require_relative "env_config"
require_relative "signing"
require_relative "keychain"
require "shellwords"

default_platform(:ios)

# ---------------------------------------------------------------------------
# Shared helpers
# ---------------------------------------------------------------------------

# Resolve the absolute path to packages/client from the fastlane directory
# (fastlane is invoked from packages/client, so __dir__ points one level in).
CLIENT_DIR = File.expand_path("..", __dir__).freeze
REPO_ROOT   = File.expand_path("../..", CLIENT_DIR).freeze

# The one iOS credential. Accepts either the key's three parts as separate
# variables, or a path to the JSON fastlane also understands — whichever the
# operator finds easier to keep in a secret store.
def asc_api_key
  common = { in_house: false, duration: 1200 }

  # A .p8 on disk still needs its key id and issuer id — the file carries
  # neither. fastlane rejects key_filepath given on its own.
  if ENV["ASC_API_KEY_PATH"] && File.exist?(ENV["ASC_API_KEY_PATH"])
    return Fastlane::Actions::AppStoreConnectApiKeyAction.run(
      **common,
      key_id:       ENV.fetch("ASC_KEY_ID"),
      issuer_id:    ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ENV["ASC_API_KEY_PATH"]
    )
  end

  Fastlane::Actions::AppStoreConnectApiKeyAction.run(
    **common,
    key_id:      ENV.fetch("ASC_KEY_ID"),
    issuer_id:   ENV.fetch("ASC_ISSUER_ID"),
    key_content: ENV.fetch("ASC_KEY_CONTENT"),
    is_key_content_base64: ENV["ASC_KEY_CONTENT_BASE64"] == "1"
  )
end

# ---------------------------------------------------------------------------
# iOS platform
# ---------------------------------------------------------------------------

import "lanes/ios.rb"
import "lanes/android.rb"
