# Appfile — identity values come from the active .env file via EnvConfig.
# Never hard-code Apple IDs, team IDs, package names, or credentials here.
#
# fastlane `eval`s this file, so `require_relative` has no basepath to infer
# and raises LoadError. It does chdir into this directory first, so an
# absolute path built from Dir.pwd is the reliable form.
require File.expand_path("env_config", Dir.pwd)

# iOS / App Store Connect. The API key carries the team, so no team ids here.
app_identifier(EnvConfig.bundle_id)

# Android — supply reads SUPPLY_PACKAGE_NAME / SUPPLY_JSON_KEY_DATA from env.
json_key_file("")
