{
  "name": "micdrp",
  "private": true,
  "types": "./node_modules/@types",
  "workspaces": {
    "packages": [
      "packages/*"
    ]
  },
  "scripts": {
    "lint": "eslint packages --ext .js,.jsx,.ts,.tsx",
    "test": "./scripts/test.sh",
    "build": "./scripts/build.sh",
    "client": "./scripts/run.sh",
    "submit": "./scripts/submit.sh",
    "typecheck": "tsc --noEmit",
    "env": "npx dotenv-vault@latest pull",
    "env-push": "npx dotenv-vault@latest push",
    "license": "license-checker --production --summary",
    "owasp": "dependency-check --project micdrp --scan . --failOnCVSS 7 --suppression ./owasp.suppression.xml || true"
  },
  "devDependencies": {
    "@babel/core": "^7.20.12",
    "@babel/preset-env": "^7.20.2",
    "@babel/preset-react": "^7.18.6",
    "@babel/preset-typescript": "^7.18.6",
    "@babel/runtime": "^7.20.7",
    "@commitlint/config-conventional": "^17.0.2",
    "@evilmartians/lefthook": "^1.3.9",
    "@react-native/babel-preset": "0.86.2",
    "@react-native/eslint-config": "0.86.2",
    "@react-native/metro-config": "0.86.2",
    "@react-native/typescript-config": "0.86.2",
    "@release-it/conventional-changelog": "^5.0.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/dotenv": "^8.2.0",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.2.5",
    "@types/lodash": "^4.14.191",
    "@types/node": "^18.11.18",
    "@types/react": "^19.1.1",
    "@types/react-test-renderer": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^5.48.1",
    "@typescript-eslint/parser": "^5.48.1",
    "babel-jest": "^29.3.1",
    "babel-plugin-module-resolver": "^4.1.0",
    "commitlint": "^17.5.1",
    "del-cli": "^5.0.0",
    "eslint": "^8.31.0",
    "eslint-config-prettier": "^8.6.0",
    "eslint-config-standard": "^17.0.0",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-n": "^15.6.0",
    "eslint-plugin-prettier": "^4.0.0",
    "eslint-plugin-promise": "^6.1.1",
    "jest": "^29.3.1",
    "pod-install": "^0.1.0",
    "prettier": "^2.8.2",
    "react": "^19.2.8",
    "react-native": "^0.86.2",
    "react-native-builder-bob": "^0.20.4",
    "react-test-renderer": "^19.2.8",
    "release-it": "^15.0.0",
    "ts-jest": "^29.0.5",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.1.6"
  },
  "packageManager": "yarn@3.6.3"
}
