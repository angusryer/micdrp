{
  "name": "micdrp",
  "private": true,
  "types": "./node_modules/@types",
  "workspaces": {
    "packages": [
      "packages/*"
    ]
  },
  "scripts": {
    "lint": "eslint packages",
    "test": "./scripts/test.sh",
    "build": "./scripts/build.sh",
    "client": "./scripts/run.sh",
    "submit": "./scripts/submit.sh",
    "typecheck": "tsc --noEmit",
    "env": "npx dotenv-vault@latest pull",
    "env-push": "npx dotenv-vault@latest push",
    "license": "license-checker --production --summary",
    "owasp": "dependency-check --project micdrp --scan . --failOnCVSS 7 --suppression ./owasp.suppression.xml || true"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@babel/runtime": "^7.29.7",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^9.39.0",
    "@evilmartians/lefthook": "^2.1.10",
    "@react-native-community/cli": "^20.2.0",
    "@react-native-community/cli-platform-android": "^20.2.0",
    "@react-native-community/cli-platform-ios": "^20.2.0",
    "@react-native/babel-preset": "0.86.2",
    "@react-native/eslint-config": "0.86.2",
    "@react-native/jest-preset": "0.86.2",
    "@react-native/metro-config": "0.86.2",
    "@react-native/typescript-config": "0.86.2",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/lodash": "^4.17.25",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-test-renderer": "^19.1.0",
    "babel-jest": "^29.7.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "commitlint": "^21.2.2",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react-hooks": "^7.1.0",
    "jest": "^29.7.0",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-native": "^0.86.2",
    "react-test-renderer": "^19.2.3",
    "test-renderer": "^1.0.0",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0"
  },
  "packageManager": "yarn@3.6.3",
  "resolutions": {
    "@babel/core": "^7.29.7",
    "jest-environment-node": "^29.7.0",
    "@types/react": "^19.2.18"
  }
