{
  // The update server for the `updates` domain. See worker.ts.
  //
  // account_id is pinned so a deploy cannot land in the wrong Cloudflare
  // account. There is more than one on this machine, and the ambient
  // CLOUDFLARE_API_TOKEN belongs to a different project — see the README.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "micdrp-ota",
  "main": "worker.ts",
  "account_id": "de2dda27b551c02cc87ab317a7e5611e",
  "compatibility_date": "2026-08-01",

  "observability": {
    "enabled": true
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "micdrp-ota",
      "database_id": "b4617106-8d65-4a4f-858e-cf2bf92a5ee6"
    }
  ],

  "r2_buckets": [
    {
      "binding": "BUNDLES",
      "bucket_name": "micdrp-ota-bundles"
    }
  ]
}
